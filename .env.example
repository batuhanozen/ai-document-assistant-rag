# Offline demo is the default: no API calls or model downloads.
APP_MODE=demo
EMBEDDING_BACKEND=hashing
DATA_DIR=./data

# Full semantic RAG: pip install -e '.[ai]'; select both settings below.
# APP_MODE=llm
# EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# An immutable Hugging Face revision can be set for reproducibility.
EMBEDDING_REVISION=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=200
PARSING_TIMEOUT_SECONDS=30
MAX_EXTRACTED_CHARS=500000
MAX_CHUNKS=2000
CHUNK_SIZE=700
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.2
MAX_CONTEXT_CHARS=6000
LOG_LEVEL=INFO
